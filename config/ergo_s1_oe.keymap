#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define FN  1

/ {
    behaviors {
        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <44 45 59 60 67 61 46 30 18 6 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 47 48 49 50 51 62 63 64 65>;
        };

        hrr: hrr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 52 53 54 55 56 57 58 66>;
        };

        bkspcapsword: bkspcapsword {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSPCAPSWORD";
            bindings = <&lt 2 BACKSPACE>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // | ESC  |  1   |  2   |  3   |  4   |  5   |                                                   |  6   |  7   |  8   |  9   |  0   | BSPC |
            // | WIN  |  Q   |  W   |  E   |  R   |  T   |                                                   |  Y   |  U   |  I   |  O   |  P   | EQL  |
            // | TAB  |  A   |  S   |  D   |  F   |  G   |                                                   |  H   |  J   |  K   |  L   | SCLN | QUOT |
            // | LCTL |  Z   |  X   |  C   |  V   |  B   |      | CTL  | ALT  |         | CAPS | CTL  |      |  N   |  M   | COMM | DOT  | SLSH | MINS |
            //        | GRV  | BSLS | LEFT | RGHT |      | SHFT |  FN  | HOME |         | PGUP | ENT  | SPC  |      |  UP  |  DN  | LBKT | RBKT |
            //                                                         | END  |         | PGDN |

            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                                                                  &kp N6    &kp N7            &kp N8             &kp N9   &kp N0    &kp MINUS
&kp ESCAPE  &kp Q   &kp W   &kp F      &kp P     &kp B                                                                   &kp J     &kp L             &kp U              &kp Y    &kp SEMI  &kp EQUAL
&kp TAB     &kp A   &kp R   &kp S      &kp T     &kp G                                                                   &kp M     &kp N             &kp E              &kp I    &kp O     &kp APOS
&kp LSHFT   &kp Z   &kp X   &kp C      &kp D     &kp V     &kp LG(LS(U))  &none  &caps_word  &kp LG(LC(LA(LEFT_SHIFT)))  &kp K     &kp H             &kp COMMA          &kp DOT  &kp FSLH  &kp RSHFT
            &none   &none   &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE      &none  &none       &kp ENTER                   &kp BSPC  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none    &none
                                                                          &none  &kp DELETE
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans        &trans        &trans        &trans
                                                        &trans  &trans
            >;
        };

        Fn {
            bindings = <
&trans  &trans  &kp F10  &kp F11  &kp F12  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F7   &kp F8   &kp F9   &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F4   &kp F5   &kp F6   &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                           &trans  &trans
            >;
        };

        Nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans     &trans     &trans     &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &caps_word  &trans    &trans     &trans     &trans     &trans
                                                        &trans  &trans
            >;
        };
    };
};
