#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define FN  1

/ {
    behaviors {
        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <44 45 59 60 67 61 46 30 18 6 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 47 48 49 50 51 62 63 64 65 43 42 56 57 58 66>;
        };

        hrr: hrr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 52 53 54 55 56 57 58 66 44 45 60 61 67 59>;
        };

        bkspcapsword: bkspcapsword {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSPCAPSWORD";
            bindings = <&lt 3 BACKSPACE>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Enthium {
            bindings = <
&kp ESC         &kp N1             &kp N2        &kp N3                &kp N4                 &kp N5                                                                        &kp N6  &kp N7            &kp N8            &kp N9        &kp N0              &kp DELETE
&kp ESC         &kp Q              &kp Y         &kp O                 &kp U                  &kp EQUAL                                                                     &kp X   &kp L             &kp D             &kp P         &kp Z               &kp ENTER
&kp B           &hrl LEFT_SHIFT C  &hrl LCTRL I  &hrl LEFT_ALT A       &hrl LEFT_GUI E        &kp MINUS                                                                     &kp K   &hrr RIGHT_GUI H  &hrr RIGHT_ALT T  &hrr RCTRL N  &hrr RIGHT_SHIFT S  &kp W
&sk LEFT_SHIFT  &kp APOS           &kp COMMA     &kp DOT               &kp SEMI               &kp FSLH   &mo 5    &mo 2     &mo 3                 &sk LS(LA(LC(LEFT_GUI)))  &kp J   &kp M             &kp G             &kp F         &kp V               &sk RIGHT_SHIFT
                &kp AMPS           &kp GRAVE     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SPACE  &kp TAB  &tog 4    &sk LS(LA(LEFT_GUI))  &kp BACKSPACE             &kp R   &sk RIGHT_SHIFT   &kp LBKT          &kp RBKT      &kp BSLH
                                                                                                                  &kp LGUI  &lt 1 ENTER
            >;
        };

        Nav {
            bindings = <
&trans           &trans         &trans     &trans          &trans            &trans                                        &trans    &trans     &trans  &trans  &trans  &trans
&kp EXCLAMATION  &trans         &trans     &trans          &trans            &kp QUESTION                                  &trans    &kp RIGHT  &trans  &trans  &trans  &trans
&kp HASH         &kp AT_SIGN    &kp EQUAL  &kp UNDERSCORE  &kp DOLLAR        &kp ASTERISK                                  &kp UP    &kp LEFT   &trans  &trans  &trans  &trans
&kp TILDE        &kp LESS_THAN  &kp PIPE   &kp MINUS       &kp GREATER_THAN  &kp PLUS      &trans  &trans  &trans  &trans  &kp DOWN  &trans     &trans  &trans  &trans  &trans
                 &kp AMPERSAND  &trans     &trans          &trans            &caps_word    &trans  &trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans
                                                                                                   &trans  &trans
            >;
        };

        Num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans  &trans  &trans  &trans
                                                        &trans  &trans
            >;
        };

        Fn {
            bindings = <
&trans  &trans  &kp F10  &kp F11  &kp F12  &trans                                  &trans          &trans             &trans           &trans      &trans  &trans
&trans  &trans  &kp F7   &kp F8   &kp F9   &trans                                  &trans          &kp C_PLAY_PAUSE   &trans           &trans      &trans  &trans
&trans  &trans  &kp F4   &kp F5   &kp F6   &trans                                  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &trans  &trans
&trans  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans  &trans  &trans  &trans  &trans          &kp K_MUTE         &trans           &trans      &trans  &trans
        &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans          &trans             &trans           &trans      &trans
                                                           &trans  &trans
            >;
        };

        Typing {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C   &kp I   &kp A   &kp E   &trans                                     &trans  &kp H   &kp T   &kp N   &kp S   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
                                                        &trans  &kp ENTER
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans        &trans        &trans        &trans
                                                        &trans  &trans
            >;
        };
    };
};
